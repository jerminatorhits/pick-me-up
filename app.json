{
  "expo": {
    "name": "Pick Me Up",
    "slug": "pick-me-up",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pickmeup",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pick Me Up uses your location to estimate how long it will take to drive to the airport.",
        "NSUserNotificationsUsageDescription": "Pick Me Up notifies you when it is time to leave for the airport."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C1220",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1220",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pick Me Up uses your location to estimate how long it will take to drive to the airport."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F0B429",
          "defaultChannel": "pickup-alerts"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
